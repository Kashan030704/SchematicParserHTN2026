# Export these in the shell; this file is documentation, not auto-loaded.
BASETEN_API_KEY=<CONFIRM>
# Recommended Baseten Model API slug for both BOM vision and orchestration tools.
BASETEN_VISION_MODEL=moonshotai/Kimi-K2.6
BASETEN_TOOL_MODEL=moonshotai/Kimi-K2.6
HCP_HOST=<CONFIRM_PI_IP>
HCP_PORT=9000
HARDWARE_CONFIG=config/hardware.json
# Voice/audio is P1 and deliberately has no P0 dependency.
